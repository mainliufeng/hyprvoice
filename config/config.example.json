{
  "audio_source": "",
  "auto_commit": true,
  "clipboard_restore": false,
  "gain": 1.0,
  "hotwords": "",
  "llm": {
    "allow_http": false,
    "api_key_env": "HYPRVOICE_API_KEY",
    "base_url": "https://api.openai.com/v1",
    "model": "",
    "timeout_seconds": 15
  },
  "max_recording_seconds": 180,
  "offline_model": "~/.local/share/hyprvoice/models/x-asr-zipformer-transducer-zh-en-punct-int8",
